# Oracle prod 서버의 .env 예시입니다. 값은 커밋하면 안됨.
# 정본은 GitHub Environments(production) Secret — 배포 시 deploy-prod.yml이 서버에 기록.

# compose용
# ⚠️ PROD_IMAGE는 배포마다 릴리즈 태그로 바뀐다 — deploy-prod.yml(CD)이 :vX.Y.Z로 주입/덮어씀.
#    수동 기동 시에만 아래 값을 실제 태그로 채운다.
PROD_IMAGE=<dockerhub-username>/be:v0.0.0
PROD_MYSQL_ROOT_PASSWORD=<생성: openssl rand -base64 32>
PROD_MYSQL_PASSWORD=<생성: openssl rand -base64 32>

# 앱용 (application.properties의 placeholder를 채운다)
ACTIVE=prod
DATABASE_URL=jdbc:mysql://mysql:3306/dolog?serverTimezone=Asia/Seoul
DATABASE_USERNAME=dolog
DATABASE_PASSWORD=<PROD_MYSQL_PASSWORD와 동일하게>
ADMIN_EMAIL=<운영 관리자 계정>
ADMIN_PASSWORD=<운영 관리자 비밀번호>
JWT_SECRET_KEY=<운영 전용 값 — dev와 공유 금지>
KAKAO_REST_API_KEY=<카카오 운영 앱 REST API 키>
KAKAO_CLIENT_SECRET=<카카오 운영 앱 Client Secret>
KAKAO_REDIRECT_URIS=<허용할 운영 FE 콜백 URL>
GOOGLE_CLIENT_ID=<운영용 GCP 프로젝트 웹 OAuth Client ID>
GOOGLE_CLIENT_SECRET=<운영용 GCP 프로젝트 웹 OAuth Client Secret>
GOOGLE_REDIRECT_URIS=<허용할 운영 FE 콜백 URL>
TERMS_CURRENT_VERSION=<현재 필수 약관 버전>

# CORS — 운영 프론트 오리진 (콤마 구분). ※ cors 프로퍼티화(A4) 머지 후 실효
CORS_ORIGINS=https://dolog.kr,https://www.dolog.kr

# S3 — 운영 버킷 + S3 전용 최소권한 IAM 키(A5에서 발급). prod 광범위 키 복사 금지.
ACCESS_KEY=<prod-s3-only IAM 액세스 키>
SECRET_KEY=<prod-s3-only IAM 시크릿 키>
BUCKET_NAME=dolog-s3-873593443627-ap-northeast-2-an
