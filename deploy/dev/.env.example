# Oracle dev 서버의 .env 예시입니다. 값은 커밋하면 안됨.

# compose용
DEV_IMAGE=<dockerhub-username>/be:dev
DEV_MYSQL_ROOT_PASSWORD=<생성>
DEV_MYSQL_PASSWORD=<생성>

# 앱용 (application.properties의 placeholder를 채운다)
ACTIVE=dev
DATABASE_URL=jdbc:mysql://mysql:3306/dolog?serverTimezone=Asia/Seoul
DATABASE_USERNAME=dolog
DATABASE_PASSWORD=<DEV_MYSQL_PASSWORD와 동일하게>
ADMIN_EMAIL=<dev용 관리자 계정>
ADMIN_PASSWORD=<dev용 관리자 비밀번호>
JWT_SECRET_KEY=<prod 값 재사용 금지>
TERMS_CURRENT_VERSION=<현재 필수 약관 버전>

# S3 — 반드시 dev 전용 IAM 키(dolog-s3-dev 버킷 한정)만 사용. prod 키 복사 금지!
ACCESS_KEY=<dolog-dev-server IAM 액세스 키>
SECRET_KEY=<dolog-dev-server IAM 시크릿 키>
BUCKET_NAME=dolog-s3-dev

# sync-dev-db.sh용 (prod 백업 S3에서 복원 — reader 키, 읽기 전용. prod 서버 접근 불필요)
BACKUP_BUCKET=dolog-prod-backup
BACKUP_AWS_ACCESS_KEY_ID=<dolog-prod-backup-reader 액세스 키>
BACKUP_AWS_SECRET_ACCESS_KEY=<reader 시크릿 키>
AWS_REGION=ap-northeast-2
