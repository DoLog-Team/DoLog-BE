# dev HTTPS(443) — 첫 인증서 발급 전에는 .disabled 상태여야 nginx가 뜬다 (init-cert.sh가 발급 후 활성화)
server {
    listen 443 ssl;
    http2 on;
    server_name dev.dolog-archive.site;

    ssl_certificate /etc/letsencrypt/live/dev.dolog-archive.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.dolog-archive.site/privkey.pem;

    # 앱 API — prod와 동일하게 /api 프리픽스 그대로 전달 (컨테이너 네트워크로 app 서비스에 직접)
    location /api {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 헬스체크 공개 (모니터링용) — 정확 매칭이라 다른 actuator 엔드포인트는 비노출
    # uptimerobot에서 HEAD로 찍힘. actuator(9090)는 HEAD에 403 → HEAD엔 nginx가 직접 200(엣지 생존).
    # 실제 app health는 GET으로 반영(CD 폴링).
    location = /health {
        if ($request_method = HEAD) { return 200; }
        proxy_pass http://app:9090/actuator/health;
    }
}
